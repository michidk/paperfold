{
  "name": "paperfold",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "PORT=3001 bun --watch server/index.ts",
    "build": "vite build",
    "start": "bun server/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:deadcode": "knip",
    "test": "bun test",
    "verify": "bun run check && bun run typecheck && bun run test && bun run lint:deadcode && bun run build",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "@types/three": "0.170.0",
    "drizzle-kit": "0.31.11",
    "knip": "6.44.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
